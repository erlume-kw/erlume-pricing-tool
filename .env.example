# Google Gemini — free tier — vision identification (Step A) + comp ranking (Step B)
# Get a free key at https://aistudio.google.com/apikey  (no credit card needed)
GEMINI_API_KEY=
# Optional: override the model (default gemini-2.0-flash)
# GEMINI_MODEL=gemini-3-flash-preview

# eBay comps — PRIMARY: official eBay Browse API (developer.ebay.com → Production keyset)
# App ID (Client ID) and Cert ID (Client Secret). Returns ACTIVE listings.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# eBay comps — FALLBACK: SerpApi (used only if EBAY_CLIENT_ID/SECRET are blank)
SERPAPI_KEY=
# SERPAPI_SOLD=1   # pull SOLD prices instead of active (SerpApi path only)

# Server port (default 3200)
PORT=3200
